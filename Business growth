<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description" content="Business Growth - practical business tools, insights and resources for entrepreneurs.">
  <meta name="keywords" content="business growth, business tools, entrepreneur, startup, business ideas">
  <meta name="author" content="Business Growth">

  <title>Business Growth | Grow Smarter</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f7f9fc;
      color: #172033;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
    }

    /* HEADER */

    header {
      width: 100%;
      background: #ffffff;
      border-bottom: 1px solid #e7ebf0;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .navbar {
      max-width: 1200px;
      margin: auto;
      min-height: 72px;
      padding: 0 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 23px;
      font-weight: 800;
      color: #126b46;
      white-space: nowrap;
    }

    .logo span {
      color: #ed7418;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 25px;
    }

    .nav-links a {
      color: #374151;
      font-size: 15px;
      font-weight: 600;
    }

    .nav-links a:hover {
      color: #126b46;
    }

    .nav-button {
      background: #126b46;
      color: white !important;
      padding: 10px 18px;
      border-radius: 25px;
    }

    /* HERO */

    .hero {
      background: linear-gradient(135deg, #eefbf4, #fff8ee);
      padding: 90px 22px 85px;
    }

    .hero-container {
      max-width: 1100px;
      margin: auto;
      text-align: center;
    }

    .hero-badge {
      display: inline-block;
      padding: 7px 14px;
      background: white;
      border: 1px solid #dce8df;
      border-radius: 30px;
      color: #126b46;
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: 54px;
      line-height: 1.12;
      max-width: 850px;
      margin: auto;
      color: #111827;
    }

    .hero h1 span {
      color: #ed7418;
    }

    .hero-text {
      max-width: 720px;
      margin: 22px auto 0;
      color: #667085;
      font-size: 18px;
    }

    .hero-buttons {
      margin-top: 30px;
    }

    .primary-button,
    .secondary-button {
      display: inline-block;
      padding: 13px 23px;
      border-radius: 28px;
      font-weight: 700;
      margin: 5px;
    }

    .primary-button {
      background: #126b46;
      color: white;
    }

    .secondary-button {
      background: white;
      color: #126b46;
      border: 1px solid #cfdad3;
    }

    /* GENERAL */

    .section {
      padding: 75px 22px;
    }

    .container {
      max-width: 1150px;
      margin: auto;
    }

    .section-heading {
      max-width: 700px;
      margin-bottom: 35px;
    }

    .section-heading h2 {
      font-size: 35px;
      margin-bottom: 10px;
      color: #111827;
    }

    .section-heading p {
      color: #697386;
    }

    /* STATS */

    .stats {
      margin-top: -30px;
      position: relative;
    }

    .stats-grid {
      max-width: 1000px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .stat-card {
      background: white;
      padding: 25px;
      border-radius: 18px;
      text-align: center;
      border: 1px solid #e5e9ef;
      box-shadow: 0 8px 25px rgba(0,0,0,0.05);
    }

    .stat-card h3 {
      font-size: 28px;
      color: #126b46;
    }

    .stat-card p {
      color: #697386;
      margin-top: 4px;
    }

    /* TOOLS */

    .tools-section {
      background: white;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .card {
      background: #ffffff;
      padding: 26px;
      border-radius: 20px;
      border: 1px solid #e5e9ef;
      box-shadow: 0 7px 24px rgba(0,0,0,0.045);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    }

    .icon {
      width: 55px;
      height: 55px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 15px;
      background: #eef8f2;
      font-size: 27px;
      margin-bottom: 18px;
    }

    .card h3 {
      font-size: 20px;
      margin-bottom: 9px;
    }

    .card p {
      color: #697386;
      font-size: 15px;
    }

    .card-link {
      display: inline-block;
      margin-top: 16px;
      color: #126b46;
      font-weight: 700;
    }

    /* INSIGHTS */

    .insight-card {
      padding: 0;
      overflow: hidden;
    }

    .insight-image {
      height: 165px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 25px;
      font-weight: 800;
      background: linear-gradient(135deg, #126b46, #ed7418);
    }

    .insight-content {
      padding: 23px;
    }

    .category {
      color: #ed7418;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .5px;
    }

    /* ABOUT */

    .about {
      background: #0f172a;
      color: white;
    }

    .about .section-heading h2 {
      color: white;
    }

    .about .section-heading p {
      color: #c6ceda;
    }

    .about-box {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
    }

    .about-card {
      padding: 28px;
      border: 1px solid #263248;
      border-radius: 20px;
      background: #141e30;
    }

    .about-card h3 {
      margin-bottom: 8px;
    }

    .about-card p {
      color: #c6ceda;
    }

    /* FAQ */

    .faq {
      max-width: 850px;
    }

    .faq-item {
      background: white;
      border: 1px solid #e5e9ef;
      border-radius: 14px;
      padding: 20px;
      margin-bottom: 12px;
    }

    .faq-item h3 {
      font-size: 17px;
      margin-bottom: 7px;
    }

    .faq-item p {
      color: #697386;
    }

    /* CONTACT */

    .contact-box {
      background: white;
      border: 1px solid #e5e9ef;
      border-radius: 22px;
      padding: 35px;
      text-align: center;
    }

    .contact-box p {
      color: #697386;
      margin-top: 8px;
    }

    /* FOOTER */

    footer {
      background: #020617;
      color: white;
      padding: 50px 22px 25px;
    }

    .footer-grid {
      max-width: 1150px;
      margin: auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 40px;
    }

    .footer-logo {
      font-size: 23px;
      font-weight: 800;
    }

    .footer-grid h3 {
      margin-bottom: 12px;
    }

    .footer-grid p,
    .footer-grid a {
      color: #9aa5b5;
      font-size: 14px;
    }

    .footer-links a {
      display: block;
      margin-bottom: 8px;
    }

    .copyright {
      max-width: 1150px;
      margin: 35px auto 0;
      padding-top: 20px;
      border-top: 1px solid #1f2937;
      color: #7e8999;
      font-size: 13px;
    }

    /* MOBILE */

    @media (max-width: 850px) {

      .nav-links {
        display: none;
      }

      .hero h1 {
        font-size: 42px;
      }

      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .about-box {
        grid-template-columns: 1fr;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 550px) {

      .hero {
        padding: 65px 18px;
      }

      .hero h1 {
        font-size: 34px;
      }

      .hero-text {
        font-size: 16px;
      }

      .section {
        padding: 55px 18px;
      }

      .section-heading h2 {
        font-size: 29px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .logo {
        font-size: 20px;
      }
    }
  </style>
</head>

